# Ignore everything by default — allowlist only what we want to track
*

# Repo files
!.gitignore
!LICENSE
!.bashrc
!install.sh
!README.md
!CLAUDE.md

# Bash split files
!bash/
!bash/**

# Git config
!git/
!git/gitconfig

# SSH config (no keys)
!ssh/
!ssh/config

# Tmux config
!tmux/
!tmux/tmux.conf

# Tool setup notes (docs + scripts only — binaries/packs dropped in here stay untracked)
!tools/
!tools/**/
!tools/**/*.md
!tools/**/*.sh
!utils.md

# Claude Code skills
!claude-skills/
!claude-skills/**

# App configs
!config/
!config/omp-themes/
!config/omp-themes/**
!config/fastfetch/
!config/fastfetch/**
!config/kitty/
!config/kitty/**
!config/i3/
!config/i3/**
!config/yazi/
!config/yazi/**
!config/btop/
!config/btop/**
!config/htop/
!config/htop/**
!config/picom/
!config/picom/**
!config/nvim/
!config/nvim/**

# Logs and generated files
*.log
btop.log

# Never track these even if accidentally staged
.ssh/id_*
.ssh/*.pub
.ssh/known_hosts
.ssh/known_hosts.old
.bashrc.bak

# Machine-local overrides
*.local
*.local.*
