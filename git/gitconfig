[user]
	name = sushantpadha
[core]
	autocrlf = input
[init]
	defaultBranch = main
[diff]
	tool = vscode
[difftool "vscode"]
	cmd = "code --wait --diff  "
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[include]
    path = ~/.gitconfig.local